---
import '@fontsource/schibsted-grotesk/400.css';
import '@fontsource/schibsted-grotesk/500.css';
import '@fontsource/schibsted-grotesk/600.css';
import '@fontsource/schibsted-grotesk/700.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';
import Lamp from '../components/Lamp.astro';
import SideNav from '../components/SideNav.astro';
import DepartureBoard from '../components/DepartureBoard.astro';
import MarketTicker from '../components/MarketTicker.astro';
import { contact } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ticker?: boolean;
}
const {
  title = 'ER5Labs — Emad Rafiq',
  description = 'The personal hub and portfolio of Emad Rafiq — projects, skills, experience, writing and experiments.',
  image = '/og-image.png',
  ticker = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const linkedinHref = contact.linkedin.startsWith('http') ? contact.linkedin : `https://${contact.linkedin}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Icons + browser UI -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f5f3ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141210" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ER5Labs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Set theme before paint to avoid a flash -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('er5-theme') === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Lamp />
    <SideNav side="left" />
    <SideNav side="right" mirror />
    {ticker && <MarketTicker />}
    <div class="page">
      <div class="masthead">
        <DepartureBoard />
      </div>
      <slot />
    </div>
    <footer class="site-footer" id="contact">
      <div class="container site-footer__inner">
        <p class="site-footer__copy">&copy; <span id="yr">2026</span> ER5Labs &middot; Emad Rafiq</p>
        <nav class="site-footer__contact" aria-label="Contact">
          <span class="site-footer__label">Get in touch</span>
          <a class="site-footer__link" href={`mailto:${contact.email}`}>{contact.email}</a>
          <a class="site-footer__link" href={linkedinHref} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      var y = document.getElementById('yr');
      if (y) y.textContent = new Date().getFullYear();
    </script>
  </body>
</html>

<style>
  /* .masthead width lives in global.css so it always applies */
  .site-footer {
    margin-top: var(--sp-7);
    padding-block: var(--sp-5);
    border-top: 1px solid var(--line);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .site-footer__copy { color: var(--muted); }
  .site-footer__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
  }
  .site-footer__label {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.66rem;
    color: var(--muted);
  }
  .site-footer__link {
    color: var(--ink-2);
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size var(--transition), color var(--transition);
    padding-bottom: 2px;
  }
  .site-footer__link:hover { color: var(--accent); background-size: 100% 1px; }
</style>
