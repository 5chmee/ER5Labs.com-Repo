---
import { destinations } from '../data/site';

// Split a label into individual flap tiles (one per character).
const tiles = (label: string) => label.split('');
---
<section class="board" aria-label="Contents: choose where to go">
  <div class="board__marquee">
    <a class="board__brand" href="/" aria-label="ER5Labs home">ER5LABS</a>
    <span class="board__depart">Contents</span>
    <span class="board__meta">
      <span class="board__weather" id="board-weather" aria-live="polite"></span>
      <span class="board__clock" id="board-clock" aria-hidden="true">--:--</span>
    </span>
  </div>

  <div class="board__head" aria-hidden="true">
    <span>Pages</span>
    <span>Destination</span>
    <span class="board__head-status">Status</span>
  </div>

  <ul class="board__rows">
    {destinations.map((d, r) => (
      <li class="board__row">
        <a class="board__link" href={d.href} data-href={d.href} style={`--row:${r}`}>
          <span class="board__flight">{d.code}</span>
          <span class="board__dest">
            <span class="board__flaps" aria-label={d.label}>
              {tiles(d.label).map((ch, i) => (
                <span class="flap" style={`--i:${i}`} data-final={ch} aria-hidden="true">{ch}</span>
              ))}
            </span>
            <span class="board__note">{d.note}</span>
          </span>
          <span class="board__status" data-state="pending">
            <span class="board__status-text">To be viewed</span>
            <span class="board__arrow" aria-hidden="true">&rarr;</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .board {
    background: var(--board-bg);
    border: 1px solid var(--board-line);
    border-radius: var(--radius-lg);
    padding: clamp(0.85rem, 2.2vw, 1.35rem) clamp(1rem, 2.6vw, 1.9rem) clamp(0.6rem, 1.6vw, 0.9rem);
    box-shadow:
      inset 0 1px 0 var(--board-inlay),
      0 34px 60px -42px rgba(0, 0, 0, 0.55);
    transition: background var(--transition), border-color var(--transition);
    /* flight | destination | status */
    --col: 4.4rem 1fr auto;
  }

  .board__marquee {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding-bottom: 0.7rem;
    font-family: var(--font-mono);
  }
  .board__brand {
    color: var(--board-amber);
    font-weight: 500;
    letter-spacing: 0.24em;
    font-size: 0.8rem;
    transition: opacity var(--transition);
  }
  .board__brand:hover { opacity: 0.8; }
  .board__depart {
    color: var(--board-dim);
    text-transform: uppercase;
    letter-spacing: 0.26em;
    font-size: 0.64rem;
  }
  .board__meta {
    margin-left: auto;
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    min-width: 0;
  }
  .board__weather {
    color: var(--board-dim);
    letter-spacing: 0.04em;
    font-size: 0.72rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 44vw;
  }
  .board__weather .wx-temp { color: var(--board-amber); }
  .board__clock {
    color: var(--board-text);
    letter-spacing: 0.1em;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  .board__head {
    display: grid;
    grid-template-columns: var(--col);
    gap: clamp(0.6rem, 2vw, 1.6rem);
    padding: 0 0.35rem 0.55rem;
    border-bottom: 1px solid var(--board-rowline);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--board-dim);
  }
  .board__head-status { text-align: right; }

  .board__rows { list-style: none; margin: 0; padding: 0; }
  .board__row + .board__row { border-top: 1px solid var(--board-rowline); }

  .board__link {
    display: grid;
    grid-template-columns: var(--col);
    gap: clamp(0.6rem, 2vw, 1.6rem);
    align-items: center;
    padding: clamp(0.5rem, 1.3vw, 0.8rem) 0.35rem;
    color: var(--board-text);
    border-radius: 6px;
    transition: background 200ms;
  }
  .board__link:hover,
  .board__link:focus-visible { background: var(--board-hover); outline: none; }
  .board__link:focus-visible { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--board-amber) 60%, transparent); }

  .board__flight {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: var(--board-amber);
    white-space: nowrap;
    align-self: center;
  }

  .board__dest { min-width: 0; }
  .board__flaps {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    perspective: 320px;
  }

  .flap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: clamp(0.8em, 2vw, 1.05em);
    padding: 0.13em 0.05em;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(0.98rem, 2.7vw, 1.55rem);
    line-height: 1;
    color: var(--board-text);
    background: linear-gradient(var(--board-slat) 0 calc(50% - 0.5px), var(--board-slat-2) calc(50% + 0.5px) 100%);
    border-radius: 3px;
    box-shadow: inset 0 0 0 1px var(--board-crease);
    position: relative;
    transform-origin: center top;
    backface-visibility: hidden;
  }
  .flap::after {
    content: '';
    position: absolute;
    left: 0; right: 0; top: 50%;
    height: 1px;
    background: var(--board-crease);
    transform: translateY(-0.5px);
  }
  /* Character flips are driven by the Web Animations API in the script below
     (compositor-smooth, no per-frame reflow). Flaps rest facing forward. */

  .board__note {
    display: block;
    margin-top: 0.38rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--board-dim);
  }

  .board__status {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    font-family: var(--font-mono);
    white-space: nowrap;
    align-self: center;
  }
  .board__status-text {
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.24rem 0.5rem;
    border-radius: 3px;
    transform-origin: center;
  }
  .board__status[data-state="viewing"] .board__status-text {
    color: var(--board-on-amber); background: var(--board-amber); font-weight: 500;
  }
  .board__status[data-state="visited"] .board__status-text {
    color: var(--board-amber); background: color-mix(in srgb, var(--board-amber) 15%, transparent);
  }
  .board__status[data-state="pending"] .board__status-text {
    color: var(--board-dim); background: color-mix(in srgb, var(--board-dim) 16%, transparent);
  }

  .board__arrow { color: var(--board-amber); transition: transform 200ms; }
  .board__link:hover .board__arrow { transform: translateX(4px); }

  /* Narrow screens: drop the flight column, tighten */
  @media (max-width: 560px) {
    .board { --col: 1fr auto; }
    .board__flight { display: none; }
    .board__head { grid-template-columns: 1fr auto; }
    .board__head span:first-child { display: none; }
    .board__weather { display: none; }
    .board__status-text { font-size: 0.6rem; letter-spacing: 0.06em; }
  }

</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pad = (n: number) => String(n).padStart(2, '0');

  // ---- Clock (adjusts to the visitor's location once weather resolves) ----
  const clock = document.getElementById('board-clock');
  let tzOffset: number | null = null; // seconds from UTC; null => device local
  const tick = () => {
    if (!clock) return;
    let hh: number, mm: number;
    if (tzOffset === null) {
      const d = new Date();
      hh = d.getHours(); mm = d.getMinutes();
    } else {
      const d = new Date(Date.now() + tzOffset * 1000);
      hh = d.getUTCHours(); mm = d.getUTCMinutes();
    }
    clock.textContent = `${pad(hh)}:${pad(mm)}`;
  };
  tick();
  window.setInterval(tick, 15000);

  // ---- Weather + location -------------------------------------------------
  const weatherEl = document.getElementById('board-weather');
  const WCODE: Record<number, string> = {
    0: 'Clear', 1: 'Mainly clear', 2: 'Partly cloudy', 3: 'Overcast',
    45: 'Fog', 48: 'Rime fog', 51: 'Light drizzle', 53: 'Drizzle', 55: 'Dense drizzle',
    56: 'Freezing drizzle', 57: 'Freezing drizzle', 61: 'Light rain', 63: 'Rain', 65: 'Heavy rain',
    66: 'Freezing rain', 67: 'Freezing rain', 71: 'Light snow', 73: 'Snow', 75: 'Heavy snow',
    77: 'Snow grains', 80: 'Rain showers', 81: 'Rain showers', 82: 'Heavy showers',
    85: 'Snow showers', 86: 'Snow showers', 95: 'Thunderstorm', 96: 'Thunderstorm', 99: 'Thunderstorm',
  };
  const WKEY = 'er5-weather';

  const paint = (text: string) => { if (weatherEl) weatherEl.innerHTML = text; };

  const showCached = (): boolean => {
    try {
      const c = JSON.parse(sessionStorage.getItem(WKEY) || 'null');
      if (c && Date.now() - c.ts < 15 * 60 * 1000) {
        if (typeof c.offset === 'number') { tzOffset = c.offset; tick(); }
        if (c.text) paint(c.text);
        return true;
      }
    } catch (e) {}
    return false;
  };

  const loadWeather = async (lat: number, lon: number) => {
    try {
      const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code&timezone=auto`;
      const j = await (await fetch(url)).json();
      if (!j || !j.current) return;
      if (typeof j.utc_offset_seconds === 'number') { tzOffset = j.utc_offset_seconds; tick(); }
      const temp = Math.round(j.current.temperature_2m);
      const desc = WCODE[j.current.weather_code] || 'Weather';

      let place = '';
      try {
        const g = await (await fetch(
          `https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${lat}&longitude=${lon}&localityLanguage=en`
        )).json();
        place = g.city || g.locality || g.principalSubdivision || '';
      } catch (e) {}

      const text = `${place ? place + ' &middot; ' : ''}<span class="wx-temp">${temp}&deg;</span> ${desc}`;
      paint(text);
      try {
        sessionStorage.setItem(WKEY, JSON.stringify({ ts: Date.now(), text, offset: tzOffset }));
      } catch (e) {}
    } catch (e) { /* leave the weather blank on failure */ }
  };

  if (!showCached() && 'geolocation' in navigator) {
    navigator.geolocation.getCurrentPosition(
      (pos) => loadWeather(pos.coords.latitude, pos.coords.longitude),
      () => { /* permission denied — clock stays on device local time, no weather */ },
      { timeout: 8000, maximumAge: 10 * 60 * 1000 }
    );
  }

  // ---- Split-flap letter animation (replays each time the board re-enters view)
  const CHARS = ' ABCDEFGHIJKLMNOPQRSTUVWXYZ.&0123456789';
  const nbsp = (c: string) => (c === ' ' ? ' ' : c);
  const tidy = (p: string) => p.replace(/\/+$/, '') || '/';
  const here = tidy(location.pathname);
  const onHome = here === '/';

  const allFlaps = Array.from(document.querySelectorAll<HTMLElement>('.flap'));
  const settle = (el: HTMLElement) => {
    el.textContent = nbsp((el.dataset.final || ' ').toUpperCase());
  };

  // On the homepage every row flips; on any other page only that page's own
  // row flips — the rest of the board stays still.
  const flaps = onHome
    ? allFlaps
    : allFlaps.filter((el) => {
        const link = el.closest('.board__link') as HTMLElement | null;
        const href = tidy(link?.dataset.href || '');
        return href !== '/' && (here === href || here.startsWith(href + '/'));
      });

  // Rows that don't animate here simply show their final characters.
  const animating = new Set(flaps);
  allFlaps.forEach((el) => { if (!animating.has(el)) settle(el); });
  let timers: number[] = [];
  let frame = 0;

  // One clock for the whole board. Every tile used to own a setInterval and
  // build a fresh Animation on each tick, which meant forty-odd timers racing
  // the same frame and a few hundred short-lived objects a second. Timers also
  // drift, so tiles that should land together arrived a frame or two apart.
  // Here a single rAF loop reads the clock once per frame and each tile keeps
  // one Animation it rewinds, so the flips stay locked to the compositor.
  const STEP = 150;
  const clearAll = () => {
    timers.forEach((id) => { window.clearTimeout(id); window.clearInterval(id); });
    timers = [];
    if (frame) { cancelAnimationFrame(frame); frame = 0; }
  };

  const runFlaps = () => {
    clearAll();

    type Tile = {
      el: HTMLElement;
      idx: number;
      target: number;
      due: number;
      anim: Animation | null;
      done: boolean;
    };

    const tiles: Tile[] = [];
    const now = performance.now();

    flaps.forEach((el) => {
      const finalCh = (el.dataset.final || ' ').toUpperCase();
      if (reduce || finalCh === ' ') { el.textContent = nbsp(finalCh); return; }
      const target = Math.max(0, CHARS.indexOf(finalCh));
      const link = el.closest('.board__link') as HTMLElement | null;
      const row = parseInt(link?.style.getPropertyValue('--row') || '0', 10) || 0;
      const i = parseInt(el.style.getPropertyValue('--i') || '0', 10) || 0;
      const spins = 6 + Math.floor(Math.random() * 7);
      // Cascade row-by-row only on the homepage; a lone row starts promptly.
      const startDelay = (onHome ? row * 210 : 0) + i * 78 + Math.floor(Math.random() * 50);
      const idx = ((target - spins) % CHARS.length + CHARS.length) % CHARS.length;
      el.textContent = nbsp(CHARS[idx]);
      tiles.push({ el, idx, target, due: now + startDelay, anim: null, done: false });
    });

    if (tiles.length === 0) return;

    let left = tiles.length;
    const tick = (time: number) => {
      for (const t of tiles) {
        if (t.done || time < t.due) continue;
        t.idx = (t.idx + 1) % CHARS.length;
        t.el.textContent = nbsp(CHARS[t.idx]);
        const last = t.idx === t.target;

        // Rewind the tile's own Animation rather than making another one.
        if (!t.anim) {
          t.anim = t.el.animate(
            [{ transform: 'rotateX(-90deg)' }, { transform: 'rotateX(0deg)' }],
            { duration: STEP, easing: 'linear', fill: 'none' }
          );
        } else {
          const effect = t.anim.effect as KeyframeEffect;
          effect.updateTiming({
            duration: last ? 320 : STEP,
            easing: last ? 'cubic-bezier(0.22, 1, 0.36, 1)' : 'linear',
          });
          t.anim.currentTime = 0;
          t.anim.play();
        }

        // Step from the deadline, not from now, so a late frame does not push
        // the whole run out of step.
        t.due += STEP;
        if (last) { t.done = true; left -= 1; }
      }
      frame = left > 0 ? requestAnimationFrame(tick) : 0;
    };

    frame = requestAnimationFrame(tick);
  };

  const boardEl = document.querySelector('.board');
  if (reduce || flaps.length === 0) {
    allFlaps.forEach(settle);
  } else if (boardEl && 'IntersectionObserver' in window) {
    // Scramble first so the answer never flashes on paint — but only while the
    // tab is actually on screen, so a page opened in a background tab is never
    // left showing gibberish.
    const prime = () => {
      flaps.forEach((el) => {
        const f = (el.dataset.final || ' ').toUpperCase();
        if (f !== ' ') el.textContent = nbsp(CHARS[Math.floor(Math.random() * CHARS.length)]);
      });
    };
    if (!document.hidden) prime();

    let visible = false;
    let started = false;
    const maybeRun = () => {
      if (!visible || document.hidden) return;
      started = true;
      // Wait for the board's own typeface. Starting mid-load meant the first
      // few flips happened while the browser was still swapping fonts and
      // relaying out every tile, which is what made the opening run stutter.
      if (document.fonts && document.fonts.status !== 'loaded') {
        document.fonts.ready.then(runFlaps);
      } else {
        runFlaps();
      }
    };

    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting && !visible) { visible = true; maybeRun(); }
        else if (!e.isIntersecting && visible) { visible = false; }
      });
    }, { threshold: 0.25 });
    io.observe(boardEl);

    // Tab revealed later (opened in the background): scramble, then flip.
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && visible && !started) { prime(); maybeRun(); }
    });

    // Safety net — never leave scrambled characters sitting on screen.
    window.setTimeout(() => { if (!started) allFlaps.forEach(settle); }, 4000);
  } else {
    runFlaps();
  }

  // ---- Status: Viewing / To be viewed / Last viewed <n> ago ---------------
  const VISIT_KEY = 'er5-visits';
  const readVisits = (): Record<string, number> => {
    try { return JSON.parse(localStorage.getItem(VISIT_KEY) || '{}'); } catch { return {}; }
  };
  const writeVisits = (v: Record<string, number>) => {
    try { localStorage.setItem(VISIT_KEY, JSON.stringify(v)); } catch {}
  };
  const norm = (p: string) => p.replace(/\/+$/, '') || '/';
  const rel = (ts: number, now: number) => {
    const mins = Math.floor(Math.max(0, now - ts) / 60000);
    if (mins < 1) return 'just now';
    if (mins < 60) return `${mins} min${mins === 1 ? '' : 's'} ago`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return `${hrs} hr${hrs === 1 ? '' : 's'} ago`;
    const days = Math.floor(hrs / 24);
    return `${days} day${days === 1 ? '' : 's'} ago`;
  };

  const now = Date.now();
  const path = norm(location.pathname);
  const visits = readVisits();
  let currentHref: string | null = null;

  Array.from(document.querySelectorAll<HTMLAnchorElement>('.board__link')).forEach((link) => {
    const href = norm(link.dataset.href || link.getAttribute('href') || '');
    const isCurrent = href !== '/' && (path === href || path.startsWith(href + '/'));
    const wrap = link.querySelector('.board__status');
    const text = link.querySelector('.board__status-text');
    if (!wrap || !text) return;

    if (isCurrent) {
      currentHref = href;
      wrap.setAttribute('data-state', 'viewing');
      text.textContent = 'Viewing';
    } else if (visits[href]) {
      wrap.setAttribute('data-state', 'visited');
      text.textContent = `Last viewed ${rel(visits[href], now)}`;
    } else {
      wrap.setAttribute('data-state', 'pending');
      text.textContent = 'To be viewed';
    }
  });

  if (currentHref) { visits[currentHref] = now; writeVisits(visits); }
</script>
