---
// Side navigation — completely hidden until the pointer reaches the page edge
// (or a link is focused), even at the top of the page. Rendered on BOTH edges
// so a visitor can reveal it from whichever side they reach for. The right copy
// is a pointer-only mirror (hidden from assistive tech to avoid duplicate links).
// On small screens both are hidden; the departure board is the navigation there.
interface Props {
  side?: 'left' | 'right';
  mirror?: boolean;
}
const { side = 'left', mirror = false } = Astro.props;

const items = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/skills', label: 'Skills' },
  { href: '/experience', label: 'Experience' },
  { href: '/entries', label: 'Entries' },
  { href: '/playground', label: 'Playground' },
];
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<nav
  class:list={["sidenav", `sidenav--${side}`]}
  aria-label={mirror ? undefined : 'Primary'}
  aria-hidden={mirror ? 'true' : undefined}
>
  <div class="sidenav__zone"></div>
  <div class="sidenav__panel">
    <ul class="sidenav__list">
      {items.map((it) => {
        const target = it.href.replace(/\/+$/, '') || '/';
        const active = target === '/' ? path === '/' : (path === target || path.startsWith(target + '/'));
        return (
          <li>
            <a
              href={it.href}
              class:list={["sidenav__link", { 'is-active': active }]}
              aria-current={active ? 'page' : undefined}
              tabindex={mirror ? -1 : undefined}
            >
              <span class="sidenav__dot" aria-hidden="true"></span>
              <span class="sidenav__label">{it.label}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</nav>

<style>
  .sidenav {
    position: fixed;
    top: 0;
    bottom: 0;
    z-index: 140;
    display: flex;
    align-items: center;
    /* This container is the full height of the viewport, so it must not take
       the pointer itself or it swallows clicks on anything behind it, above
       and below the panel. Only the edge strip and the revealed panel do. */
    pointer-events: none;
  }
  .sidenav--left { left: 0; justify-content: flex-start; }
  .sidenav--right { right: 0; justify-content: flex-end; }

  /* Invisible strip along the edge that catches the hover */
  .sidenav__zone {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 22px;
    pointer-events: auto;
  }
  .sidenav--left .sidenav__zone { left: 0; }
  .sidenav--right .sidenav__zone { right: 0; }

  .sidenav__panel {
    position: relative;
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.14);
    backdrop-filter: blur(10px);
    /* Hidden by default: slid off toward its own edge and faded out, and
       inert until it is actually on screen. */
    opacity: 0;
    pointer-events: none;
    transition: transform 260ms cubic-bezier(0.4, 0, 0.2, 1), opacity 220ms ease;
  }
  .sidenav--left .sidenav__panel { margin-left: 0.6rem; transform: translateX(-118%); }
  .sidenav--right .sidenav__panel { margin-right: 0.6rem; transform: translateX(118%); }

  /* Reveal on hover of the nav (zone or panel) or keyboard focus */
  .sidenav:hover .sidenav__panel,
  .sidenav:focus-within .sidenav__panel {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  .sidenav__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0;
    margin: 0;
  }
  .sidenav__link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius);
    color: var(--ink-2);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: color var(--transition), background var(--transition);
  }
  /* Mirror the row on the right so the dot sits toward the edge */
  .sidenav--right .sidenav__link { flex-direction: row-reverse; text-align: right; }

  .sidenav__dot {
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line-2);
    transition: background var(--transition), transform var(--transition);
  }
  .sidenav__link:hover { color: var(--ink); background: var(--bg-2); }
  .sidenav__link:hover .sidenav__dot { background: var(--accent); }
  .sidenav__link.is-active { color: var(--ink); }
  .sidenav__link.is-active .sidenav__dot { background: var(--accent); transform: scale(1.35); }

  /* Mobile: no hover — the departure board is the navigation */
  @media (max-width: 899px) {
    .sidenav { display: none; }
  }
</style>
