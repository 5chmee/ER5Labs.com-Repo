---
// Side navigation — completely hidden until the pointer reaches the left edge
// (or a link is focused), even at the top of the page. On small screens it is
// hidden entirely; the departure board is the navigation there.
const items = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/skills', label: 'Skills' },
  { href: '/experience', label: 'Experience' },
  { href: '/entries', label: 'Entries' },
  { href: '/playground', label: 'Playground' },
];
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<nav class="sidenav" aria-label="Primary">
  <div class="sidenav__zone"></div>
  <div class="sidenav__panel">
    <ul class="sidenav__list">
      {items.map((it) => {
        const target = it.href.replace(/\/+$/, '') || '/';
        const active = target === '/' ? path === '/' : (path === target || path.startsWith(target + '/'));
        return (
          <li>
            <a href={it.href} class:list={["sidenav__link", { 'is-active': active }]} aria-current={active ? 'page' : undefined}>
              <span class="sidenav__dot" aria-hidden="true"></span>
              <span class="sidenav__label">{it.label}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</nav>

<style>
  .sidenav {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 140;
    display: flex;
    align-items: center;
  }
  /* Invisible strip along the left edge that catches the hover */
  .sidenav__zone {
    position: absolute;
    inset: 0 auto 0 0;
    width: 22px;
  }
  .sidenav__panel {
    position: relative;
    margin-left: 0.6rem;
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.14);
    backdrop-filter: blur(10px);
    /* Hidden by default — slid off to the left and faded out */
    opacity: 0;
    transform: translateX(-118%);
    transition: transform 260ms cubic-bezier(0.4, 0, 0.2, 1), opacity 220ms ease;
  }
  /* Reveal on hover of the nav (zone or panel) or keyboard focus */
  .sidenav:hover .sidenav__panel,
  .sidenav:focus-within .sidenav__panel {
    opacity: 1;
    transform: translateX(0);
  }

  .sidenav__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0;
    margin: 0;
  }
  .sidenav__link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius);
    color: var(--ink-2);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: color var(--transition), background var(--transition);
  }
  .sidenav__dot {
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line-2);
    transition: background var(--transition), transform var(--transition);
  }
  .sidenav__link:hover { color: var(--ink); background: var(--bg-2); }
  .sidenav__link:hover .sidenav__dot { background: var(--accent); }
  .sidenav__link.is-active { color: var(--ink); }
  .sidenav__link.is-active .sidenav__dot { background: var(--accent); transform: scale(1.35); }

  /* Mobile: no hover — the departure board is the navigation */
  @media (max-width: 899px) {
    .sidenav { display: none; }
  }
</style>
