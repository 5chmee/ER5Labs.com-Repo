---
// Bitcoin mining game, played against a REAL block.
//
// What is real here: the 80-byte header (version, previous hash, merkle root,
// timestamp, bits, nonce) is the genuine header of the latest block on the
// Bitcoin network, fetched live. The hashing is real double SHA-256, the same
// function miners run. Feed it the real winning nonce and it reproduces that
// block's real hash exactly.
//
// What is not real: the payout. Nobody can win Bitcoin here, because the real
// target needs ~10^23 hashes and a browser manages ~10^4-10^6 per second. So
// the game scores you against a much easier PRACTICE target while showing the
// real one alongside, for scale.
//
// Please keep these guardrails if you edit this file:
//   * nothing computes until the visitor opts in and presses Start
//   * the visitor sets what share of the processor to use
//   * it stops itself when the tab goes to the background
//   * no coins are mined, earned or transferred, and nothing is submitted
//     anywhere. There is no pool, no wallet and no payout.
---
<div class="miner">
  <div class="miner__consent" id="m-consent">
    <h4 class="miner__consent-title">Before you start</h4>
    <ul class="miner__consent-list">
      <li>
        This runs real double SHA-256 <strong>on your own device</strong> against the real
        header of the latest Bitcoin block, so it uses some processor time while it runs.
      </li>
      <li>
        <strong>Nothing is earned.</strong> No cryptocurrency is mined, paid or transferred,
        to you, to me or to anyone. No wallet, no mining pool, nothing submitted anywhere.
        The real target needs about 10<sup>23</sup> hashes, so you are scored against a much
        easier practice target instead.
      </li>
      <li>
        Nothing runs until you press Start. You choose how much processor to give it, you
        can stop at any moment, and it pauses itself if you switch tabs.
      </li>
    </ul>
    <button type="button" class="miner__btn miner__btn--go" id="m-agree">
      I understand, show the demo
    </button>
  </div>

  <div class="miner__game" id="m-game" hidden>
    <div class="miner__stats">
      <div class="miner__stat">
        <span class="miner__k">Real block</span>
        <span class="miner__v" id="m-height">…</span>
      </div>
      <div class="miner__stat">
        <span class="miner__k">Network</span>
        <span class="miner__v" id="m-net">…</span>
      </div>
      <div class="miner__stat">
        <span class="miner__k">Your rate</span>
        <span class="miner__v" id="m-rate">0 H/s</span>
      </div>
      <div class="miner__stat">
        <span class="miner__k">Practice blocks</span>
        <span class="miner__v" id="m-blocks">0</span>
      </div>
    </div>

    <div class="miner__block">
      <p class="miner__hdr">Real 80-byte block header</p>
      <div class="miner__line"><span class="miner__k">Version</span><span class="miner__mono" id="m-version">…</span></div>
      <div class="miner__line"><span class="miner__k">Prev block</span><span class="miner__mono miner__dim" id="m-prev">…</span></div>
      <div class="miner__line"><span class="miner__k">Merkle root</span><span class="miner__mono miner__dim" id="m-merkle">…</span></div>
      <div class="miner__line"><span class="miner__k">Time / bits</span><span class="miner__mono" id="m-time">…</span></div>
      <div class="miner__line"><span class="miner__k">Nonce</span><span class="miner__mono" id="m-nonce">0</span></div>
      <div class="miner__line miner__line--hash">
        <span class="miner__k">Hash</span>
        <span class="miner__mono miner__hash" id="m-hash">press mine to begin</span>
      </div>
    </div>

    <p class="miner__target">
      Practice target: hash begins with <span class="miner__zeros" id="m-target">0000</span>
      <span class="miner__odds" id="m-odds"></span>
    </p>
    <p class="miner__target">
      Real target: <span class="miner__mono miner__dim" id="m-realtarget">…</span>
    </p>

    <div class="miner__controls">
      <div class="miner__field">
        <label for="m-diff">Practice difficulty</label>
        <select id="m-diff">
          <option value="3">3 zeros</option>
          <option value="4" selected>4 zeros</option>
          <option value="5">5 zeros</option>
          <option value="6">6 zeros</option>
          <option value="7">7 zeros</option>
        </select>
      </div>

      <div class="miner__field miner__field--range">
        <label for="m-effort">Processor effort</label>
        <input type="range" id="m-effort" min="10" max="100" step="10" value="30" aria-describedby="m-effort-out" />
        <output id="m-effort-out" for="m-effort">30%</output>
      </div>
    </div>

    <div class="miner__controls">
      <button type="button" class="miner__btn" id="m-once">Try one nonce</button>
      <button type="button" class="miner__btn" id="m-real">Use the real winning nonce</button>
      <button type="button" class="miner__btn miner__btn--go" id="m-auto">Start mining</button>
      <button type="button" class="miner__btn" id="m-reset">Reset</button>
      <span class="miner__status" id="m-status" role="status" aria-live="polite">Loading block…</span>
    </div>

    <ul class="miner__chain" id="m-chain" aria-label="Practice hits you have found"></ul>

    <p class="miner__note" id="m-note"></p>
    <p class="miner__legal">
      The header and the hashing are real. The payout is not: no cryptocurrency is mined,
      earned or transferred to anyone, and nothing is submitted to any network.
    </p>
  </div>
</div>

<!-- Global (namespaced under .miner): chain entries are built in the script, so
     they never carry Astro's scoping attribute. -->
<style is:global>
  .miner { display: grid; gap: 1rem; }

  .miner__consent {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    padding: clamp(1rem, 3vw, 1.5rem);
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-lg);
  }
  .miner__consent-title { font-size: var(--step-1); }
  .miner__consent-list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.1rem;
    max-width: 42rem;
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.6;
  }
  .miner__consent-list strong { color: var(--ink); }

  .miner__game { display: grid; gap: 1rem; }

  .miner__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  @media (min-width: 560px) { .miner__stats { grid-template-columns: repeat(4, 1fr); } }
  .miner__stat { display: grid; gap: 0.25rem; padding: 0.7rem 0.85rem; background: var(--surface); }
  .miner__k {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--muted);
  }
  .miner__v {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .miner__block {
    display: grid;
    gap: 0.45rem;
    padding: clamp(0.85rem, 2.5vw, 1.15rem);
    background: var(--board-bg);
    border: 1px solid var(--board-line);
    border-radius: var(--radius-lg);
  }
  .miner__hdr {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--board-amber);
    margin-bottom: 0.2rem;
  }
  .miner__block .miner__k { color: var(--board-dim); }
  .miner__line { display: flex; gap: 0.9rem; align-items: baseline; }
  .miner__line .miner__k { flex: 0 0 5.4rem; }
  .miner__mono {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--board-text);
    word-break: break-all;
    font-variant-numeric: tabular-nums;
  }
  .miner__dim { color: var(--board-dim); }
  .miner__hash { line-height: 1.5; }
  .miner__hash .zeros { color: var(--up); font-weight: 500; }
  .miner__block.is-won { box-shadow: 0 0 0 1px var(--board-amber); }

  .miner__target { font-family: var(--font-mono); font-size: var(--step--1); color: var(--ink-2); }
  .miner__zeros { color: var(--accent); }
  .miner__odds { color: var(--muted); }

  .miner__controls { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; }
  .miner__field {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .miner__field select {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: none;
    letter-spacing: 0;
    padding: 0.4rem 0.5rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
  }
  .miner__field--range input { accent-color: var(--accent); width: 8.5rem; }
  .miner__field output { color: var(--ink); font-variant-numeric: tabular-nums; }

  .miner__btn {
    padding: 0.5rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--ink-2);
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition);
  }
  .miner__btn:hover { color: var(--accent); border-color: var(--accent); }
  .miner__btn--go { color: var(--on-accent); background: var(--accent); border-color: var(--accent); }
  .miner__btn--go:hover { color: var(--on-accent); background: var(--accent-2); border-color: var(--accent-2); }
  .miner__btn:disabled { opacity: 0.45; cursor: not-allowed; }

  .miner__status {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .miner__status[data-on='true'] { color: var(--up); }

  .miner__chain { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; }
  .miner__chain li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.3rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--ink-2);
    background: var(--bg-2);
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
  }
  .miner__chain li b { color: var(--accent); font-weight: 500; }

  .miner__note, .miner__legal {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .miner__legal { color: var(--ink-2); }
</style>

<script>
  const root = document.querySelector('.miner');
  if (root && window.crypto?.subtle) {
    const $ = (id: string) => document.getElementById(id)!;

    // Snapshot used only if the live lookup fails, so the demo still works.
    // Verified: this header with this nonce reproduces the block's real hash.
    const FALLBACK = {
      height: 959820,
      version: 543711232,
      previousblockhash: '000000000000000000018fe9dcd3b3b97a08a2a4758074cb61f6eb13f8edad39',
      merkle_root: 'e875a5aceb380c19562f4964b5a24e3af1b591fafb9ba68523d3f4a5d8b3fcb1',
      timestamp: 1785144795,
      bits: 386022100,
      nonce: 3692993034,
      difficulty: 126231507121868.2,
      networkHashrate: 8.769e20,
    };

    let block: typeof FALLBACK = FALLBACK;
    let header = new Uint8Array(80);
    let difficulty = 4;
    let nonce = 0;
    let hashes = 0;
    let blocks = 0;
    let rate = 0;
    let lastRate = 0; // kept after stopping so the scale note stays on screen
    let mining = false;

    const num = (n: number) => n.toLocaleString('en-GB');
    const effort = () => Number(($('m-effort') as HTMLInputElement).value) / 100;
    const target = () => '0'.repeat(difficulty);

    // ---- header assembly (little-endian ints, hashes in internal order) ----
    const hexToBytesReversed = (hex: string) => {
      const out = new Uint8Array(hex.length / 2);
      for (let i = 0; i < out.length; i++) {
        out[out.length - 1 - i] = parseInt(hex.substr(i * 2, 2), 16);
      }
      return out;
    };
    const writeU32LE = (buf: Uint8Array, off: number, v: number) => {
      buf[off] = v & 0xff;
      buf[off + 1] = (v >>> 8) & 0xff;
      buf[off + 2] = (v >>> 16) & 0xff;
      buf[off + 3] = (v >>> 24) & 0xff;
    };
    const buildHeader = () => {
      const h = new Uint8Array(80);
      writeU32LE(h, 0, block.version);
      h.set(hexToBytesReversed(block.previousblockhash), 4);
      h.set(hexToBytesReversed(block.merkle_root), 36);
      writeU32LE(h, 68, block.timestamp);
      writeU32LE(h, 72, block.bits);
      writeU32LE(h, 76, 0);
      header = h;
    };

    // Bitcoin hashes the header twice, then reads the result back to front.
    const hashAt = async (n: number) => {
      writeU32LE(header, 76, n >>> 0);
      const once = await crypto.subtle.digest('SHA-256', header);
      const twice = new Uint8Array(await crypto.subtle.digest('SHA-256', once));
      let out = '';
      for (let i = twice.length - 1; i >= 0; i--) out += twice[i].toString(16).padStart(2, '0');
      return out;
    };

    // Compact "bits" unpacks into the 256-bit target a real block must beat.
    const realTargetHex = () => {
      const exp = block.bits >>> 24;
      const mant = BigInt(block.bits & 0x00ffffff);
      const t = mant * (1n << BigInt(8 * (exp - 3)));
      return t.toString(16).padStart(64, '0');
    };

    const paintHash = (h: string) => {
      const lead = (h.match(/^0*/) || [''])[0];
      $('m-hash').innerHTML = lead ? `<span class="zeros">${lead}</span>${h.slice(lead.length)}` : h;
    };
    const setStatus = (t: string, on = false) => {
      $('m-status').textContent = t;
      $('m-status').setAttribute('data-on', String(on));
    };
    const short = (h: string) => `${h.slice(0, 8)}…${h.slice(-6)}`;

    const paintStats = () => {
      $('m-height').textContent = `#${num(block.height)}`;
      $('m-net').textContent = block.networkHashrate
        ? `${(block.networkHashrate / 1e18).toFixed(0)} EH/s`
        : 'unknown';
      $('m-rate').textContent = `${num(rate)} H/s`;
      $('m-blocks').textContent = String(blocks);
      $('m-version').textContent = `0x${block.version.toString(16)}`;
      $('m-prev').textContent = short(block.previousblockhash);
      $('m-merkle').textContent = short(block.merkle_root);
      $('m-time').textContent = `${block.timestamp} / 0x${block.bits.toString(16)}`;
      $('m-nonce').textContent = num(nonce);
      $('m-target').textContent = target();
      $('m-odds').textContent = ` (about 1 in ${num(Math.pow(16, difficulty))} hashes)`;
      $('m-realtarget').textContent = `${realTargetHex().slice(0, 32)}…`;

      // Honest scale: how long the real target would take at this rate.
      if (lastRate > 0 && block.networkHashrate) {
        const expected = block.difficulty * Math.pow(2, 32); // hashes for one real block
        const years = expected / lastRate / (60 * 60 * 24 * 365);
        $('m-note').textContent =
          `Real difficulty needs about ${expected.toExponential(1)} hashes for one block. At ${num(lastRate)} H/s that is roughly ${years.toExponential(1)} years, versus about ten minutes for the whole network at ${(block.networkHashrate / 1e18).toFixed(0)} EH/s. That gap is why nobody mines Bitcoin in a browser.`;
      } else {
        $('m-note').textContent =
          'The header below is the real one from the latest block. Press Start to hash it.';
      }
    };

    const addChip = (h: string, n: number) => {
      const li = document.createElement('li');
      li.innerHTML = `<b>${target()}</b> nonce ${num(n)}`;
      const chain = $('m-chain');
      chain.prepend(li);
      while (chain.children.length > 8) chain.lastElementChild?.remove();
    };

    const won = (h: string, n: number) => {
      blocks++;
      addChip(h, n);
      const blockEl = root.querySelector('.miner__block') as HTMLElement;
      blockEl.classList.add('is-won');
      window.setTimeout(() => blockEl.classList.remove('is-won'), 1200);
      setStatus(`Practice target met at nonce ${num(n)}`, mining);
      paintStats();
    };

    const tryOne = async () => {
      nonce = (nonce + 1) >>> 0;
      const h = await hashAt(nonce);
      hashes++;
      paintHash(h);
      if (h.startsWith(target())) won(h, nonce);
      paintStats();
    };

    const loop = async () => {
      if (!mining) return;
      const CHUNK = 150;
      const t0 = performance.now();
      let last = '';
      for (let i = 0; i < CHUNK; i++) {
        nonce = (nonce + 1) >>> 0;
        last = await hashAt(nonce);
        hashes++;
        if (last.startsWith(target())) {
          paintHash(last);
          won(last, nonce);
          window.setTimeout(() => { if (mining) loop(); }, 900);
          return;
        }
      }
      const dt = performance.now() - t0;
      const e = effort();
      const idle = e >= 1 ? 0 : Math.min(500, Math.round((dt * (1 - e)) / e));
      if (dt + idle > 0) { rate = Math.round(CHUNK / ((dt + idle) / 1000)); lastRate = rate; }
      paintHash(last);
      paintStats();
      window.setTimeout(loop, idle);
    };

    const setMining = (on: boolean, why?: string) => {
      mining = on;
      ($('m-auto') as HTMLButtonElement).textContent = on ? 'Stop mining' : 'Start mining';
      ($('m-once') as HTMLButtonElement).disabled = on;
      ($('m-real') as HTMLButtonElement).disabled = on;
      if (on) {
        setStatus(`Mining at ${Math.round(effort() * 100)}% effort`, true);
        loop();
      } else {
        rate = 0;
        setStatus(why || 'Stopped');
        paintStats();
      }
    };

    // ---- consent gate: nothing above runs until this is accepted -----------
    const CONSENT_KEY = 'er5-miner-consent';
    const loadBlock = async () => {
      try {
        const res = await fetch('/api/bitcoin.json', { cache: 'no-store' });
        if (res.ok) {
          const j = await res.json();
          if (j && typeof j.version === 'number') block = j;
        }
      } catch {
        /* keep the verified fallback */
      }
      buildHeader();
      paintStats();
      setStatus('Idle');
    };
    const reveal = () => {
      $('m-consent').hidden = true;
      $('m-game').hidden = false;
      void loadBlock();
    };
    try {
      if (localStorage.getItem(CONSENT_KEY) === 'yes') reveal();
    } catch {}
    $('m-agree').addEventListener('click', () => {
      try { localStorage.setItem(CONSENT_KEY, 'yes'); } catch {}
      reveal();
      ($('m-auto') as HTMLButtonElement).focus();
    });

    $('m-once').addEventListener('click', () => { void tryOne(); });
    $('m-auto').addEventListener('click', () => setMining(!mining));
    $('m-real').addEventListener('click', async () => {
      // Proof that this is the genuine article: the real nonce reproduces the
      // real block hash, which really does beat the real network target.
      nonce = block.nonce;
      const h = await hashAt(nonce);
      hashes++;
      paintHash(h);
      const beats = BigInt('0x' + h) <= BigInt('0x' + realTargetHex());
      setStatus(beats ? `That is block #${num(block.height)}, and it beats the real target` : 'Hash computed');
      paintStats();
    });
    $('m-reset').addEventListener('click', () => {
      setMining(false, 'Reset');
      nonce = 0; hashes = 0; blocks = 0; rate = 0;
      $('m-chain').innerHTML = '';
      $('m-hash').textContent = 'press mine to begin';
      paintStats();
    });
    $('m-diff').addEventListener('change', (e) => {
      difficulty = Number((e.target as HTMLSelectElement).value);
      paintStats();
    });
    $('m-effort').addEventListener('input', () => {
      const pct = Math.round(effort() * 100);
      ($('m-effort-out') as HTMLOutputElement).value = `${pct}%`;
      if (mining) setStatus(`Mining at ${pct}% effort`, true);
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden && mining) setMining(false, 'Paused, you left the tab');
    });
  }
</script>
