---
// ===========================================================================
// LATEST ADDITION TO THE PLAYGROUND — shown at the bottom of the homepage.
//
// The metadata comes from src/data/playground.ts: whichever experiment is
// first in that list is the one shown here. To swap it, reorder that list and
// register the component in the DEMOS map below (same map as
// src/pages/playground/[slug].astro).
// ===========================================================================
import { latest } from '../data/playground';
import BitcoinMiner from './experiments/BitcoinMiner.astro';
import SplitFlapToy from './experiments/SplitFlapToy.astro';

const DEMOS: Record<string, any> = {
  'bitcoin-mining-game': BitcoinMiner,
  'split-flap-toy': SplitFlapToy,
};
const Demo = DEMOS[latest.slug];
---
<section class="latest section container band" aria-labelledby="latest-title">
  <div class="grid2">
    <h2 class="eyebrow" id="latest-title">Latest in the Playground</h2>
    <div>
      <div class="latest__head">
        <h3 class="latest__name">
          <a class="latest__link" href={`/playground/${latest.slug}`}>{latest.title}</a>
        </h3>
        <span class="latest__date">Added {latest.added}</span>
      </div>
      <p class="latest__blurb">{latest.intro}</p>

      {Demo && (
        <div class="latest__stage">
          <Demo />
        </div>
      )}

      <a class="latest__more link-underline" href="/playground">See the rest of the Playground</a>
    </div>
  </div>
</section>

<style>
  .latest { border-top: 1px solid var(--line); }
  .grid2 { display: grid; gap: 0.9rem 2.5rem; }
  @media (min-width: 720px) {
    .grid2 { grid-template-columns: 9rem 1fr; }
  }
  .grid2 > .eyebrow { padding-top: 0.4rem; }

  .latest__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
  }
  .latest__name { font-size: var(--step-1); }
  .latest__link { transition: color var(--transition); }
  .latest__link:hover { color: var(--accent); }
  .latest__date {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .latest__blurb {
    max-width: 34rem;
    margin-top: 0.5rem;
    color: var(--ink-2);
  }
  .latest__stage { margin-top: 1.5rem; }
  .latest__more {
    display: inline-block;
    margin-top: 1.35rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>
