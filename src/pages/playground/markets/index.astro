---
// Today's tracked stocks, streaming live, each linking to its own report.
import Site from '../../../layouts/Site.astro';
import { quotes, type Quote } from '../../../lib/quotes';
import { rateLimited } from '../../../lib/http';

export const prerender = false;

const limited = rateLimited(Astro);
if (limited) return limited;
if (Astro.url.search) return Astro.redirect('/playground/markets', 308);

let items: Quote[] = [];
let updated = Date.now();
try {
  const body = await quotes();
  items = body.items;
  updated = body.updated;
} catch {
  items = [];
}
Astro.response.headers.set('Cache-Control', items.length ? 'public, s-maxage=60, stale-while-revalidate=300' : 'no-store');

const money = (q: Quote) =>
  q.price.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + (q.unit === 'yield' ? '%' : '');
const dir = (v: number | null) => (v === null ? '' : v > 0 ? 'up' : v < 0 ? 'down' : '');
const move = (v: number | null) => (v === null ? '' : `${v > 0 ? '▲ ' : v < 0 ? '▼ ' : ''}${Math.abs(v).toFixed(2)}%`);
---
<Site
  title="Markets, explained · ER5 Labs"
  description="The most traded and most discussed stocks today, streaming live, each with a page on what moved it."
  active="playground"
  skipTo="#main"
>
  <main id="main" class="sheet">
    <article class="detail markets">
      <a class="back" href="/#/playground">&larr; Playground</a>
      <h1>Markets, explained</h1>
      <div class="detail__body">
        <p class="detail__lede">
          The stocks most traded and most discussed today, with prices streaming live while the market trades.
          Select one to see what moved it: the news, the forum chatter and the numbers, with every source linked.
        </p>
      </div>

      <div id="report">
        {items.length ? (
          <ul class="board">
            {items.map((q) => (
              <li>
                <a class="board__row" href={`/playground/markets/${encodeURIComponent(q.symbol)}`} data-sym={q.symbol} data-unit={q.unit}>
                  <span class="board__sym">{q.label}{q.label !== q.symbol && <small>{q.symbol}</small>}</span>
                  <span class="board__px" data-px data-value={q.price}>{money(q)}</span>
                  <span class={`mv ${dir(q.changePct)}`} data-mv>{move(q.changePct)}</span>
                  <span class="board__go" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="markets__muted">The market data is not answering right now. Try again in a minute.</p>
        )}
        <p class="markets__muted">
          <span class="ticker__live"><span class="ticker__dot" aria-hidden="true"></span>Live</span>
          · last streamed trade <span data-time>waiting for the market</span>
          · list as at {new Date(updated).toLocaleTimeString('en-GB', { timeZone: 'UTC' })} UTC
        </p>
      </div>

      <section class="markets__how">
        <h2>How it works</h2>
        <p>
          The list is rebuilt daily from what Yahoo Finance readers are looking up and what Reddit and Stocktwits are
          talking about, ranked so a name has to be popular in both to lead. Prices come from Yahoo Finance's live
          price stream, straight to your browser, and only while this tab is open.
        </p>
        <p>
          Each stock's page is rebuilt every minute from its price history, the latest headlines and its forum
          activity. The explanation says what coincided with the move, not what caused it, and is not investment
          advice.
        </p>
      </section>
    </article>
  </main>
</Site>

<script>
  import '../../../scripts/stock-page.js';
</script>

<style>
  .markets { max-width: 820px; }
  .board { list-style: none; margin: 1.6rem 0 0.8rem; padding: 0; border-top: 1px solid var(--rule); }
  .board__row {
    display: grid; grid-template-columns: minmax(0, 1fr) auto 6.5rem 1.2rem; gap: 1rem; align-items: baseline;
    padding: 0.8rem 0.2rem; border-bottom: 1px solid var(--rule); text-decoration: none;
  }
  .board__row:hover { background: var(--mark); }
  .board__row:hover .board__sym { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--accent); }
  .board__sym { font-family: var(--ui); font-weight: 600; }
  .board__sym small { margin-left: 0.5rem; font-family: var(--mono); font-weight: 400; font-size: 0.7rem; color: var(--muted); }
  .board__px { font-family: var(--mono); font-variant-numeric: tabular-nums; }
  .board__row .mv { font-family: var(--mono); font-size: 0.85rem; text-align: right; font-variant-numeric: tabular-nums; }
  .board__go { color: var(--muted); }
  .markets__muted { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); }
  .markets__how { border-top: 1px solid var(--rule); margin-top: 2rem; padding-top: 1.3rem; }
  .markets__how h2 { font-family: var(--ui); font-weight: 600; font-size: 1.05rem; margin: 0 0 0.6rem; }
  .markets__how p { max-width: var(--measure); color: var(--ink-2); }
  @media (max-width: 560px) {
    .board__row { grid-template-columns: minmax(0, 1fr) auto 5.2rem; }
    .board__go { display: none; }
  }
</style>
