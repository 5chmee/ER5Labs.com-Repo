---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { noteFor } from '../data/site';
import SplitFlapToy from '../components/experiments/SplitFlapToy.astro';

// Edit this list to add experiments. Give each a link (href) if there's a demo.
const experiments = [
  {
    title: 'Bitcoin mining game',
    note: 'Hunt for a nonce whose SHA-256 hash starts with enough zeros. Playable at the bottom of the homepage.',
    href: '/#latest-title',
    tag: 'Latest',
  },
  {
    title: 'Split-flap toy',
    note: 'Type anything and the tiles turn over to spell it, the same way the board does.',
    href: '#split-flap',
    tag: 'CSS · JS',
  },
];
---
<Base title="Playground · ER5Labs" description="Experiments and demos by Emad Rafiq.">
  <main id="main">
    <PageHeader
      title="Playground"
      lead={noteFor('/playground')}
    />
    <div class="container section--tight">
      <ul class="play">
        {experiments.map((x) => (
          <li class="play__item">
            {x.href ? (
              <a class="play__link" href={x.href}>
                <span class="play__title">{x.title}</span>
                <span class="play__tag">{x.tag}</span>
                <span class="play__note">{x.note}</span>
              </a>
            ) : (
              <div class="play__link play__link--static">
                <span class="play__title">{x.title}</span>
                <span class="play__tag">{x.tag}</span>
                <span class="play__note">{x.note}</span>
              </div>
            )}
          </li>
        ))}
      </ul>

      <section class="demo" id="split-flap">
        <h2 class="demo__title">Split-flap toy</h2>
        <p class="demo__note">Type anything, up to ten characters.</p>
        <SplitFlapToy />
      </section>
    </div>
  </main>
</Base>

<style>
  .play {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 680px) {
    .play { grid-template-columns: repeat(2, 1fr); }
  }
  .play__link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem 1rem;
    height: 100%;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--ink);
    transition: border-color var(--transition), transform var(--transition);
  }
  a.play__link:hover { border-color: var(--accent); transform: translateY(-2px); }
  .play__link--static { opacity: 0.72; }
  .play__title { font-size: var(--step-1); font-weight: 600; }
  .play__tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    align-self: center;
  }
  .play__note { grid-column: 1 / -1; color: var(--ink-2); font-size: var(--step--1); }

  .demo {
    margin-top: clamp(2.5rem, 7vh, 4rem);
    padding-top: clamp(1.5rem, 4vh, 2.25rem);
    border-top: 1px solid var(--line);
    scroll-margin-top: 2rem;
  }
  .demo__title { font-size: var(--step-1); }
  .demo__note { margin: 0.4rem 0 1.35rem; color: var(--muted); font-size: var(--step--1); }
</style>
