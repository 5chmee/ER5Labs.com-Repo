---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';

// Edit this list to add experiments. Give each a link (href) if there's a demo.
const experiments = [
  {
    title: 'Split-flap departure board',
    note: 'The homepage board — CSS flap tiles with a staggered flip-in and a little JavaScript.',
    href: '/',
    tag: 'CSS · JS',
  },
  {
    title: 'Your next experiment',
    note: 'Drop demos, sketches and interactive bits here as you build them.',
    tag: 'WIP',
  },
];
---
<Base title="Playground — ER5Labs" description="Experiments and demos by Emad Rafiq.">
  <main id="main">
    <PageHeader
      title="Playground"
      lead="Small experiments, demos and ideas I am testing out."
    />
    <div class="container section--tight">
      <ul class="play">
        {experiments.map((x) => (
          <li class="play__item">
            {x.href ? (
              <a class="play__link" href={x.href}>
                <span class="play__title">{x.title}</span>
                <span class="play__tag">{x.tag}</span>
                <span class="play__note">{x.note}</span>
              </a>
            ) : (
              <div class="play__link play__link--static">
                <span class="play__title">{x.title}</span>
                <span class="play__tag">{x.tag}</span>
                <span class="play__note">{x.note}</span>
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </main>
</Base>

<style>
  .play {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 680px) {
    .play { grid-template-columns: repeat(2, 1fr); }
  }
  .play__link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem 1rem;
    height: 100%;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--ink);
    transition: border-color var(--transition), transform var(--transition);
  }
  a.play__link:hover { border-color: var(--accent); transform: translateY(-2px); }
  .play__link--static { opacity: 0.72; }
  .play__title { font-size: var(--step-1); font-weight: 600; }
  .play__tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    align-self: center;
  }
  .play__note { grid-column: 1 / -1; color: var(--ink-2); font-size: var(--step--1); }
</style>
