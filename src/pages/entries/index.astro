---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('entries', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Entries — ER5Labs" description="Writing and notes by Emad Rafiq.">
  <main id="main">
    <PageHeader
      title="Entries"
      lead="Thoughts, notes and write-ups on finance, data and building things."
    />
    <div class="container section--tight">
      <ul class="entries">
        {entries.map((e) => (
          <li>
            <a class="entries__item" href={`/entries/${e.id}`}>
              <time class="entries__date" datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
              <span class="entries__title">{e.data.title}</span>
              {e.data.summary && <span class="entries__sum">{e.data.summary}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</Base>

<style>
  .entries { list-style: none; margin: 0; padding: 0; }
  .entries__item {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    padding: clamp(1.25rem, 3vw, 1.75rem) 0;
    border-top: 1px solid var(--line);
    color: var(--ink);
    transition: color var(--transition);
  }
  .entries li:last-child .entries__item { border-bottom: 1px solid var(--line); }
  .entries__date {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .entries__title { font-size: var(--step-1); font-weight: 600; }
  .entries__sum { grid-column: 2; color: var(--ink-2); font-size: var(--step--1); }
  .entries__item:hover { color: var(--accent); }
  @media (max-width: 560px) {
    .entries__item { grid-template-columns: 1fr; }
    .entries__sum { grid-column: 1; }
  }
</style>
