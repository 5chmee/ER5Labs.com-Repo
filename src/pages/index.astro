---
import Base from '../layouts/Base.astro';
---
<Base>
  <main id="main" class="section container">
    <p class="eyebrow">Personal hub &amp; portfolio</p>
    <h1 style="margin-top:0.75rem;">ER5Labs</h1>
    <p class="measure" style="color:var(--ink-2); margin-top:1.25rem; font-size:var(--step-1);">
      Chrome check — pull the lamp cord (top-right) to switch light/dark, and hover
      the rail on the left to navigate. The departure board and full homepage land
      in the next stage.
    </p>
  </main>
</Base>
