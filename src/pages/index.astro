---
import Base from '../layouts/Base.astro';
import { profile, recent, interests, contact } from '../data/site';

const linkedinHref = contact.linkedin.startsWith('http')
  ? contact.linkedin
  : `https://${contact.linkedin}`;
---
<Base>
  <main id="main">
    <h1 class="sr-only">ER5Labs — the personal hub of Emad Rafiq</h1>
    <section class="hero container">
      <p class="eyebrow hero__kicker">Choose a destination above &mdash; or read on</p>
      <p class="hero__intro">{profile.intro}</p>
    </section>

    <section class="section container band">
      <div class="grid2">
        <h2 class="eyebrow">About</h2>
        <div class="about measure">
          {profile.about.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section class="section container band">
      <div class="grid2">
        <h2 class="eyebrow">Recent &amp; current</h2>
        <div>
          <ul class="recent">
            {recent.map((r) => (
              <li>
                <a href={r.href} class="recent__item">
                  <span class="recent__title">{r.title}</span>
                  <span class="recent__status">{r.status}</span>
                  <span class="recent__note">{r.note}</span>
                </a>
              </li>
            ))}
          </ul>
          <ul class="chips" aria-label="Interests">
            {interests.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="section container band" id="contact">
      <div class="grid2">
        <h2 class="eyebrow">Contact</h2>
        <div class="contact">
          <p class="contact__lead">Open to collaborations, questions, or just to say hello.</p>
          <div class="contact__links">
            <a class="contact__link" href={`mailto:${contact.email}`}>
              <span class="contact__type">Email</span>
              <span class="contact__val">{contact.email}</span>
            </a>
            <a class="contact__link" href={linkedinHref} target="_blank" rel="noopener noreferrer">
              <span class="contact__type">LinkedIn</span>
              <span class="contact__val">Connect on LinkedIn</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero {
    padding-top: clamp(1.5rem, 4vh, 2.75rem);
    padding-bottom: clamp(1.5rem, 5vh, 3rem);
  }
  .hero__kicker { margin-bottom: 1rem; }
  .hero__intro {
    max-width: 34rem;
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: balance;
  }

  .band { border-top: 1px solid var(--line); }

  .grid2 { display: grid; gap: 0.9rem 2.5rem; }
  @media (min-width: 720px) {
    .grid2 { grid-template-columns: 9rem 1fr; }
  }
  .grid2 > .eyebrow { padding-top: 0.4rem; }

  .about p {
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .about p + p { margin-top: 1rem; }

  .recent { list-style: none; margin: 0 0 1.5rem; padding: 0; }
  .recent__item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.2rem 1rem;
    align-items: baseline;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    color: var(--ink);
    transition: color var(--transition);
  }
  .recent li:last-child .recent__item { border-bottom: 1px solid var(--line); }
  .recent__title { font-weight: 600; font-size: var(--step-1); }
  .recent__note { grid-column: 1; color: var(--muted); font-size: var(--step--1); }
  .recent__status {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    align-self: center;
  }
  .recent__item:hover .recent__title { color: var(--accent); }

  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; }
  .chips li {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 100px;
    color: var(--ink-2);
  }

  .contact__lead {
    max-width: var(--measure);
    margin-bottom: 1.25rem;
    color: var(--ink-2);
    font-size: var(--step-1);
  }
  .contact__links { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .contact__link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    transition: border-color var(--transition), transform var(--transition);
  }
  .contact__link:hover { border-color: var(--accent); transform: translateY(-2px); }
  .contact__type {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
  }
  .contact__val { font-size: var(--step--1); }
</style>
