---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { skillGroups } from '../data/skills';
import { noteFor } from '../data/site';
---
<Base title="Skills · ER5Labs" description="Tools and technologies Emad Rafiq works with.">
  <main id="main">
    <PageHeader
      title="Skills"
      lead={noteFor('/skills')}
    />
    <div class="container section--tight">
      <div class="skills">
        {skillGroups.map((g) => (
          <section class="skills__group">
            <h2 class="skills__cat">{g.category}</h2>
            <ul class="skills__list">
              {g.items.map((i) => <li>{i}</li>)}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </main>
</Base>

<style>
  .skills { display: grid; gap: 0; }
  .skills__group {
    display: grid;
    gap: 0.75rem 2.5rem;
    padding: clamp(1.5rem, 4vw, 2.25rem) 0;
    border-top: 1px solid var(--line);
  }
  .skills__group:last-child { border-bottom: 1px solid var(--line); }
  @media (min-width: 720px) {
    .skills__group { grid-template-columns: 14rem 1fr; }
  }
  .skills__cat { font-size: var(--step-1); }
  .skills__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }
  .skills__list li {
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: var(--step--1);
  }
</style>
