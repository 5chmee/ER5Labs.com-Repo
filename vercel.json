{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/projects", "destination": "/#/projects", "permanent": false },
    { "source": "/projects/confidential-ai-tool", "destination": "/#/i/confidential-ai", "permanent": false },
    { "source": "/projects/er5labs", "destination": "/#/i/er5labs", "permanent": false },
    { "source": "/projects/:slug", "destination": "/#/projects", "permanent": false },
    { "source": "/playground", "destination": "/#/playground", "permanent": false },
    { "source": "/playground/split-flap-toy", "destination": "/#/playground", "permanent": false },
    { "source": "/entries/mining-a-real-block-in-the-browser", "destination": "/playground/bitcoin-mining-game#walkthrough", "permanent": false },
    { "source": "/entries", "destination": "/#/writing", "permanent": false },
    { "source": "/entries/:slug", "destination": "/#/writing", "permanent": false },
    { "source": "/skills", "destination": "/#/about", "permanent": false },
    { "source": "/experience", "destination": "/#/about", "permanent": false },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.er5labs.com" }],
      "destination": "https://er5labs.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "emadrafiq.com" }],
      "destination": "https://er5labs.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.emadrafiq.com" }],
      "destination": "https://er5labs.com/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'sha256-o38oXzO4c2iT5Ighpvg1bDI3xAdM0Dn5yw4sye/KDRk=' 'sha256-4TJLJaobuqtQZyogjOxRpI8rv8Y/F5hFpBuqog8Bl84='; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' wss://mempool.space wss://streamer.finance.yahoo.com; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
        },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" }
      ]
    },
    {
      "source": "/(.*)\\.(png|svg|ico|webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
