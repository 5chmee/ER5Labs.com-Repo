# Portable Node runtime (installed locally so it survives this environment)
.tools/

# Dependencies
node_modules/

# Astro build output
dist/
.astro/
.vercel/

# Environment / secrets — never commit these
.env
.env.*
!.env.example

# Large local installer — does not belong in the repo
Git-2.55.0.3-64-bit.exe

# Old vanilla site — preserved locally for reference, out of the repo
legacy/

# Reference documents (docs/). The generator and the written source are
# versioned so the PDFs can be rebuilt anywhere; the generated PDFs and any
# source material are not, since they are binaries and may describe client work.
docs/**/*.pdf
docs/**/*.docx
docs/_generator/node_modules/

# Editor and agent workspace settings. Local machine config, and launch.json
# can reference paths to unrelated projects, so it stays out of the repo.
.vscode/
.claude/

# OS / editor cruft
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
